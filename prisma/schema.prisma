// VidiaForge — Professional Video Editing PWA
// Prisma schema. Provider is PostgreSQL (migrated from SQLite).
// DATABASE_URL env var must be set (no hardcoding).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  avatarUrl    String?
  plan         String   @default("free") // free | creator | pro | business
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects       Project[]
  assets         MediaAsset[]
  sessions       Session[]
  preferences    UserPreferences?
  subscriptions  Subscription[]
  usageRecords   UsageRecord[]
  comments       Comment[]
  projectShares  ProjectShare[]
  uploadIntents  UploadIntent[]
  // V19 §11: creator-owned templates
  templates      Template[]       @relation("TemplateCreator")
  // V19 §11: creator profile (one-to-one)
  creatorProfile CreatorProfile?
  // V19 §56: brand kits
  brandKits      BrandKit[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?

  // Canvas
  width        Int    @default(1920)
  height       Int    @default(1080)
  fps          Int    @default(30)
  canvasPreset String @default("16:9") // 16:9 | 9:16 | 1:1 | 4:5 | 4:3 | 21:9 | custom
  resolution   String @default("1080p") // 480p | 720p | 1080p | 1440p | 4K

  // Timeline (versioned JSON, non-destructive)
  schemaVersion Int    @default(1)
  timelineData  String @default("{}") // JSON: tracks, clips, markers, text, captions, effects
  duration      Float  @default(0)

  thumbnailUrl String?
  favorite     Boolean @default(false)

  // Recovery / autosave
  lastSnapshot String?
  lastSavedAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastOpenedAt DateTime @default(now())

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets        MediaAsset[]
  renderJobs    RenderJob[]
  versions      ProjectVersion[]
  // V19 §55: snapshot history (auto + manual versions)
  snapshots     ProjectVersionSnapshot[]
  shares        ProjectShare[]
  comments      Comment[]
  uploadIntents UploadIntent[]

  @@index([userId])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  label     String?
  snapshot  String // full timeline JSON
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model MediaAsset {
  id        String  @id @default(cuid())
  userId    String
  projectId String?

  filename     String // original filename (sanitized on upload)
  internalName String // generated internal id-based name on disk
  mimeType     String
  size         Int // bytes
  storagePath  String // relative path under UPLOAD_DIR or S3 key

  // Media metadata
  kind          String // video | audio | image
  duration      Float? // seconds (video/audio)
  width         Int?
  height        Int?
  fps           Float?
  codec         String?
  audioChannels Int?

  thumbnailUrl String? // poster frame / waveform image
  waveformUrl  String?

  // === S1: ingestion pipeline tracking (uploading|processing|ready|failed) ===
  // The media-ingestion worker flips these as it progresses through
  // probe → thumbnail → waveform → proxy. Failed jobs record a clear error
  // message + timestamp so the UI can show retry affordances.
  status       String    @default("uploading") // uploading | processing | ready | failed
  errorMessage String?
  failedAt     DateTime?

  // === V4-S2: worker lease / heartbeat for crash recovery ===
  // `processingWorkerId` identifies the worker instance that claimed this
  // asset; `processingStartedAt` is when it began; `processingHeartbeatAt`
  // is updated periodically while the worker is actively processing. If
  // `processingHeartbeatAt` falls behind `RENDER_JOB_STALE_AFTER_MS` (default
  // 30min), the recovery sweep treats the worker as crashed and marks the
  // asset failed — distinguishing a crashed worker from a slow/healthy one.
  processingStartedAt   DateTime?
  processingWorkerId    String?
  processingHeartbeatAt DateTime?

  // === S1: proxy media self-reference ===
  // When the worker generates a 720p proxy for a high-res source, the proxy
  // is stored as a separate MediaAsset row whose `proxyAssetId` points back to
  // the original. The original asset's `proxyAssetId` is null.
  proxyAssetId String?
  proxyFor     MediaAsset?  @relation("MediaAssetProxy", fields: [proxyAssetId], references: [id], onDelete: SetNull)
  proxies      MediaAsset[] @relation("MediaAssetProxy")

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([proxyAssetId])
  @@index([processingHeartbeatAt])
}

model RenderJob {
  id        String @id @default(cuid())
  projectId String

  status     String @default("queued") // queued | preparing | processing | encoding | uploading | completed | failed | cancelled
  format     String @default("mp4") // mp4 | webm | mov
  codec      String @default("h264") // h264 | h265 | vp9 | av1
  resolution String @default("1080p")
  fps        Int    @default(30)
  bitrate    String @default("medium") // low | medium | high | custom

  progress  Float   @default(0) // 0..1
  stage     String? // "preparing" | "encoding" | "uploading" | "completed" | "failed"
  outputUrl String? // signed download URL or relative path
  error     String?

  // === S2: link RenderJob → output MediaAsset ===
  // When the worker completes a render, it creates a new MediaAsset row for
  // the rendered output (kind='video') and stores the row's id here. The UI
  // can then list + download renders like any other media asset. Nullable so
  // queued/failed/cancelled jobs don't require an output row.
  outputAssetId String?

  // === V4-S2: worker lease / heartbeat for crash recovery ===
  // `workerId` identifies the worker instance that claimed this job (UUID,
  // generated once at worker startup); `attemptId` is a UUID unique per
  // attempt — the worker includes it on every DB update so a stale worker
  // (e.g. mid-crash) cannot overwrite a newer retry's progress.
  // `heartbeatAt` is updated every ~20s while FFmpeg is running. If
  // `heartbeatAt` falls behind `RENDER_JOB_STALE_AFTER_MS` (default 30min),
  // the recovery sweep treats the worker as crashed and marks the job failed.
  // `attempt` is incremented on each retry so dashboards can surface
  // "attempt 2/3" hints to the user.
  workerId    String?
  attemptId   String?
  heartbeatAt DateTime?
  attempt     Int       @default(0)

  // === V4-S2: timeline content hash for render deduplication ===
  // SHA-256 of the render-relevant timeline content (tracks, clips, markers,
  // in/out points, transforms, effects, filters, transitions, keyframes,
  // masks, text, captions, audio) — excludes irrelevant UI state (selection,
  // scroll, zoom). Two projects with the same timelineHash + render options
  // produce byte-identical output, so the dedup check can reuse a completed
  // render instead of re-encoding. A timeline edit changes the hash, forcing
  // a new render.
  timelineHash String?

  // V6: renderIdentity — deterministic hash of (projectId + timelineHash +
  // format + resolution + fps + bitrate). Used for race-safe deduplication:
  // a partial unique index on (renderIdentity) WHERE status IN
  // ('queued','processing','completed') prevents concurrent requests from
  // creating duplicate active jobs. Failed/cancelled jobs are excluded so
  // retries can proceed. See migration 0007.
  renderIdentity String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([outputAssetId])
  @@index([workerId])
  @@index([heartbeatAt])
  @@index([timelineHash])
  @@index([renderIdentity])
}

model AIJob {
  id        String  @id @default(cuid())
  userId    String
  projectId String?

  kind     String // transcribe | captions | highlights | remove-bg | audio-cleanup | edit | translate | reframe
  status   String  @default("queued") // queued | processing | completed | failed
  input    String // JSON input
  output   String? // JSON output
  provider String? // openai | deepgram | local | zai
  error    String?

  // V11.1: Durable AIJob lease/ownership fields — persisted to PostgreSQL
  workerId            String?
  attemptId           String?
  heartbeatAt         DateTime?
  processingStartedAt DateTime?
  attempt             Int       @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([heartbeatAt])
  @@index([workerId])
}

model Template {
  id               String    @id @default(cuid())
  // V19 §11: creator ownership (null = builtin)
  creatorId        String?
  // V19 §4: title + description + category + tags
  title            String
  description      String?
  // V19 §6: category system — supports Trending, Social, Lifestyle, Events, Business, Creator, Visual Styles, Music
  category         String
  // V19 §6: subcategory (e.g., "TikTok" under "Social")
  subcategory      String?
  // V19 §7: tags for discovery + search
  tags             String    @default("[]") // JSON array of strings
  // V19 §9: thumbnail + animated preview
  thumbnailUrl     String?
  previewUrl       String? // animated GIF/MP4 preview
  // V19 §4: aspect ratio (16:9 | 9:16 | 1:1 | 4:5 | 4:3 | 21:9)
  aspectRatio      String    @default("16:9")
  canvasPreset     String    @default("16:9")
  width            Int       @default(1920)
  height           Int       @default(1080)
  fps              Int       @default(30)
  duration         Float
  // V19 §4: full timeline structure (JSON) — tracks, clips, markers, slots
  timelineData     String
  // V19 §4: slot definitions — references to placeholders that can be replaced
  slots            String    @default("[]") // JSON array of TemplateSlot
  // V19 §10: cover image + preview
  cover            String?
  // V19 §13: marketplace tier
  tier             String    @default("free") // free | premium | creator_exclusive | sponsored | enterprise | brand
  // V19 §14: license metadata
  license          String    @default("{}") // JSON: { type, commercialUse, territory, expiration, musicRights, stockRights }
  // V19 §12: versioning
  version          Int       @default(1)
  parentTemplateId String? // for versioning — points to v1
  // V19 §11: publication status — creator program workflow
  status           String    @default("published") // draft | submitted | under_review | approved | rejected | published | suspended | archived
  // V19 §8: ranking signals (real metrics, not fake popularity)
  usageCount       Int       @default(0)
  likeCount        Int       @default(0)
  saveCount        Int       @default(0)
  shareCount       Int       @default(0)
  viewCount        Int       @default(0)
  completionRate   Float     @default(0) // % of users who completed rendering with this template
  // V19 §1: feature flag — false = "Coming Soon" badge
  isBuiltin        Boolean   @default(true)
  isFeatured       Boolean   @default(false) // editor's picks
  isTrending       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  publishedAt      DateTime?

  creator          User?           @relation("TemplateCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  creatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?

  @@index([creatorId])
  @@index([category])
  @@index([subcategory])
  @@index([status])
  @@index([tier])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([usageCount])
  @@index([publishedAt])
}

// V19 §11: Creator profile — separate from User so non-creators don't carry the metadata
model CreatorProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  displayName     String
  avatarUrl       String?
  bio             String?
  // V19 §11: verified badge
  verified        Boolean   @default(false)
  // V19 §11: social metrics
  followers       Int       @default(0)
  following       Int       @default(0)
  templateCount   Int       @default(0)
  totalUsageCount Int       @default(0) // sum of all template uses
  rating          Float     @default(0) // 0-5 average rating
  ratingCount     Int       @default(0)
  // V19 §11: program status
  programStatus   String    @default("none") // none | applied | approved | rejected | suspended
  appliedAt       DateTime?
  approvedAt      DateTime?
  // V19 §13: payout info (for premium templates)
  payoutMethod    String?
  payoutEmail     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates Template[]

  @@index([programStatus])
  @@index([verified])
}

// V19 §55: Template version snapshot — preserves prior versions when creator publishes updates
model TemplateVersion {
  id           String   @id @default(cuid())
  templateId   String
  version      Int
  timelineData String // full snapshot
  slots        String   @default("[]")
  changelog    String?
  publishedAt  DateTime @default(now())
  publishedBy  String?

  @@index([templateId])
  @@index([version])
}

// V19 §55: Project version snapshot
model ProjectVersionSnapshot {
  id        String   @id @default(cuid())
  projectId String
  version   Int
  snapshot  String // full timeline JSON
  label     String?
  createdBy String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([version])
}

// V19 §56: Brand Kit — logos, colors, fonts, watermark, intro/outro, social handles
model BrandKit {
  id                String   @id @default(cuid())
  userId            String
  name              String   @default("Default")
  // Logos — storageKeys of uploaded logo variations
  logos             String   @default("[]") // JSON: [{ storageKey, label, transparent: true }]
  // Brand colors — palette + per-purpose colors
  colors            String   @default("{}") // JSON: { primary, secondary, accent, background, text, gradients: [] }
  // Brand fonts — font family names (loaded from system or web fonts)
  fonts             String   @default("{}") // JSON: { heading, body, accent }
  // Watermark
  watermark         String? // storageKey
  watermarkPosition String   @default("bottom-right")
  watermarkOpacity  Float    @default(0.5)
  watermarkSize     Float    @default(0.1) // fraction of canvas width
  // Intro/outro — asset IDs or storageKeys
  introAssetId      String?
  outroAssetId      String?
  // Social handles
  socialHandles     String   @default("{}") // JSON: { tiktok, instagram, youtube, x, facebook, linkedin, website }
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// V19 §77: Template analytics — aggregate metrics per template
model TemplateAnalytics {
  id         String   @id @default(cuid())
  templateId String
  // V19 §77: tracked events
  event      String // view | use | like | save | share | complete | abandon
  userId     String?
  // V19 §77: context (which project, what category)
  projectId  String?
  metadata   String   @default("{}") // JSON: additional context (e.g., slot count, render duration)
  createdAt  DateTime @default(now())

  @@index([templateId])
  @@index([event])
  @@index([userId])
  @@index([createdAt])
}

// V19 §46: Stock media catalog — provider-agnostic
model StockAsset {
  id                  String   @id @default(cuid())
  provider            String // pexels | pixabay | unsplash | storyblocks | internal
  externalId          String // provider's asset ID
  type                String // video | image | music | sfx
  title               String?
  description         String?
  // V19 §46: preview + download URLs (provider-specific)
  previewUrl          String?
  downloadUrl         String?
  // V19 §46: metadata
  width               Int?
  height              Int?
  duration            Float? // for video/audio
  mimeType            String?
  // V19 §46: licensing — must be honest about commercial-use rights
  license             String   @default("unknown") // cc0 | cc-by | cc-by-sa | royalty-free | editorial | rights-managed
  commercialUse       Boolean  @default(false)
  attributionRequired Boolean  @default(false)
  // V19 §46: search/discovery
  tags                String   @default("[]")
  category            String?
  // V19 §40: AI-indexed metadata for smart search
  indexedFaces        String   @default("[]") // JSON array of detected face IDs
  indexedObjects      String   @default("[]") // JSON array of detected object labels
  indexedScenes       String   @default("[]")
  indexedSpeech       String   @default("[]")
  // V19 §8: ranking signals
  likes               Int      @default(0)
  downloads           Int      @default(0)
  createdAt           DateTime @default(now())

  @@unique([provider, externalId])
  @@index([provider])
  @@index([type])
  @@index([license])
  @@index([category])
}

// V19 §47: Sticker library — static, animated, AI-generated
model Sticker {
  id              String   @id @default(cuid())
  name            String
  category        String // emoji | shape | arrow | bubble | decoration | ai-generated
  type            String // static | animated | ai
  // V19 §47: storage — PNG (static), GIF/APNG/WebP (animated), or SVG
  storageKey      String
  thumbnailUrl    String?
  // V19 §47: default properties
  width           Int      @default(200)
  height          Int      @default(200)
  // V19 §47: tags for search
  tags            String   @default("[]")
  isBuiltin       Boolean  @default(true)
  isAnimated      Boolean  @default(false)
  // V19 §47: AI generation metadata (if type=ai)
  generatedBy     String? // LLM provider name
  generatedPrompt String?
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([type])
  @@index([isBuiltin])
}

// V19 §48: Filter library — categorized FFmpeg filter presets
model FilterPreset {
  id           String   @id @default(cuid())
  name         String
  category     String // cinematic | vintage | retro | portrait | food | travel | night | bw | fashion | warm | cool | social
  // V19 §48: FFmpeg filter chain — real render implementation
  filterChain  String // e.g., "eq=contrast=1.2:brightness=0.05:saturation=1.1,hue=h=10:s=1.1"
  // V19 §48: parameters for UI customization
  params       String   @default("[]") // JSON: [{ key, label, type, min, max, default, value }]
  thumbnailUrl String?
  isBuiltin    Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([category])
}

// V19 §49: Effect library — categorized FFmpeg effect presets
model EffectPreset {
  id           String   @id @default(cuid())
  name         String
  category     String // blur | glow | light | lens | distortion | glitch | retro | film | vhs | noise | sharpen | stylize | body
  // V19 §49: FFmpeg filter chain
  filterChain  String
  params       String   @default("[]")
  thumbnailUrl String?
  isBuiltin    Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([category])
}

// V19 §50: Transition library — FFmpeg xfade filter presets
model TransitionPreset {
  id              String   @id @default(cuid())
  name            String
  // V19 §50: xfade transition types — must map to actual ffmpeg xfade implementations
  xfadeType       String // fade | wipeleft | wiperight | wipeup | wipedown | slideleft | slideright | slideup | slidedown | circlecrop | rectcrop | distance | fadeblack | fadewhite | radial | smoothleft | smoothright | smoothup | smoothdown | circleopen | circleclose | verticalopen | verticalclose | dissolve | pixelize | diagtl | diagtr | diagbl | diagbr | hlslice | hrslice | vuslice | vdslice | hblur | fadegrays | wipetl | wipetr | wipebl | wipebr | squeezeh | squeezev | zoomin | zoomout | discard | horzopen | horzclose | vertopen | vertclose | crossfade | afr | dither | pinspin | none | glitch | morph | mask | lightleak | filmburn | flash | whippan
  category        String // basic | wipe | slide | zoom | blur | glitch | light | film | mask | morph
  defaultDuration Float    @default(0.5) // seconds
  params          String   @default("[]")
  thumbnailUrl    String?
  isBuiltin       Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([xfadeType])
}

// V19 §18 + §56: BrandKit relation to User — multiple kits per user allowed
model UserPreferences {
  userId              String  @id
  theme               String  @default("dark")
  timecodeFormat      String  @default("hhmmssff") // hhmmssff | seconds
  snap                Boolean @default(true)
  magneticTimeline    Boolean @default(true)
  autoSave            Boolean @default(true)
  autoSaveInterval    Int     @default(5) // seconds
  proxyMedia          Boolean @default(true)
  playbackSpeed       Float   @default(1)
  defaultCanvasPreset String  @default("16:9")
  defaultResolution   String  @default("1080p")
  defaultFps          Int     @default(30)
  shortcuts           String  @default("{}") // JSON overrides
  brandKit            String  @default("{}") // JSON: logo, colors, fonts, watermark, intro, outro

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// === New models added in R2 (production backend migration) ===

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  plan                   String // free | creator | pro | business
  status                 String    @default("active") // active | past_due | canceled | incomplete
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  provider               String? // stripe | paddle | lemonsqueezy
  providerSubscriptionId String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model UsageRecord {
  id                String   @id @default(cuid())
  userId            String
  month             String // YYYY-MM (e.g. "2025-03")
  aiCreditsUsed     Int      @default(0)
  renderSecondsUsed Int      @default(0)
  storageBytesUsed  BigInt   @default(0)
  projectsCreated   Int      @default(0)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // V4-S2: previously `userId` was the PK — that prevented storing multiple
  // months per user (one row would be upserted in place). Composite unique on
  // (userId, month) enforces one row per user per month; an independent `id`
  // column (cuid) is the PK so inserts/upserts don't have to lock on the
  // user's row. Index on `userId` for the dashboard "show my usage" query.
  @@unique([userId, month])
  @@index([userId])
  @@index([month])
}

model ProjectShare {
  id         String    @id @default(cuid())
  projectId  String
  shareToken String    @unique
  permission String    @default("view") // view | comment | edit
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Comment {
  id           String   @id @default(cuid())
  projectId    String
  clipId       String?
  timelineTime Float?
  userId       String
  body         String
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([clipId])
}

// === V4-S1: UploadIntent — secure upload pipeline ===
// Created when a user initiates an upload (POST /api/assets/upload).
// Records the expected storageKey, size, MIME, and ownership so the finalize
// endpoint (POST /api/assets/finalize) can verify the client isn't claiming
// arbitrary keys they don't own. The status transitions:
//   created  → intent created, awaiting direct-to-S3 upload
//   uploaded → (local multipart path only) file already saved to storage
//   finalized → MediaAsset created + intent locked
//   expired  → past expiresAt (1 hour) and never finalized
//   failed   → size mismatch or storage error during finalize
model UploadIntent {
  id           String    @id @default(cuid())
  userId       String
  projectId    String
  storageKey   String    @unique
  filename     String
  expectedSize BigInt
  expectedMime String
  status       String    @default("created") // created | uploaded | finalized | expired | failed
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  finalizedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([expiresAt])
}
